# Copia este archivo a .env y pon una contraseña larga y aleatoria, de 16 caracteres o más (no se sube a git).
HORMA_DB_PASSWORD=cambia-esto
# Contraseña del rol restringido que usa la web (otra distinta, también de 16 o más caracteres).
HORMA_WEB_PASSWORD=cambia-esto

# Dirección oficial de la web (para las cookies y para volver de Google). Con https:// las cookies llevan «Secure».
HORMA_URL=http://localhost:3000
# Entrar con Google (opcional: sin estas dos, el botón no sale). Se crean en Google Cloud Console → Credenciales →
# ID de cliente de OAuth (aplicación web). URI de redirección autorizado: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
